{
  "schemaVersion": 2,
  "project": {
    "id": "private-environment",
    "displayName": "private Profile",
    "description": "Auto-generated private isolation profile.",
    "template": "private"
  },
  "application": {
    "provider": "brave",
    "executable": null,
    "arguments": [],
    "initialUrl": "about:blank"
  },
  "network": {
    "mode": "allowlist",
    "allowedDomains": [],
    "deniedDomains": [],
    "allowedIps": [],
    "allowedCidrs": [],
    "allowedPorts": [443],
    "allowHttp": false,
